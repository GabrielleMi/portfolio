<model-viewer
  id="robot-viewer"
  src="/portfolio/models/robot/character@walk.glb"
  shadow-intensity="1"
  disable-zoom
  autoplay
  environment-image="neutral"
  exposure="0.06"
  class="h-screen w-screen fixed pointer-events-none top-0 left-0 right-0"
>
  <effect-composer render-mode="quality" msaa="8"
    ><bloom-effect strength="6.0" radius="0.6" threshold="0.1"> </bloom-effect>
  </effect-composer>
</model-viewer>
<script>
  import type { ModelViewerElement, RGB, RGBA } from "@google/model-viewer";

  const viewer = document.getElementById("robot-viewer") as ModelViewerElement;

  (function () {
    if (!viewer) {
      return;
    }

    viewer.addEventListener("load", () => {
      const qualiaDetails = document.getElementById("qualia-details");
      const qualiaDescription = document.getElementById("qualia-description");

      if (!qualiaDetails || !qualiaDescription) {
        console.warn("Qualia details or description not found");
        return;
      }

      if (!viewer.model) {
        return;
      }

      interface MaterialConfig {
        color: string | RGBA;
        emissive: string | RGB;
        roughness: number;
      }

      const MATERIAL_HELMET = "03 - Default";
      const MATERIAL_CABLES = "truc";
      const colorMap: { [key: string]: MaterialConfig } = {
        "01 - Default": {
          color: "#31081f",
          emissive: [0.0, 0.0, 0.0],
          roughness: 0.8,
        },
        [MATERIAL_HELMET]: {
          color: [0.0, 0.8, 1.0, 1.0],
          emissive: [0.0, 40.0, 40.0],
          roughness: 0.05,
        },
        "02 - Default": {
          color: "#1b1b1b",
          emissive: [0.0, 0.0, 0.0],
          roughness: 0.8,
        },
        [MATERIAL_CABLES]: {
          color: "#1b1b1b",
          emissive: [0.0, 0.0, 0.0],
          roughness: 0.8,
        },
      };

      viewer.model.materials.forEach((material) => {
        const config = colorMap[material.name];

        if (config) {
          material.pbrMetallicRoughness.setBaseColorFactor(config.color);
          material.pbrMetallicRoughness.setRoughnessFactor(config.roughness);
          material.pbrMetallicRoughness.setMetallicFactor(0.1);

          material.setAlphaMode("OPAQUE");
          material.setEmissiveFactor(config.emissive);
        }
      });

      qualiaDetails.addEventListener("scroll", () => {
        const scrollTop = qualiaDetails.scrollTop;
        const progress = Math.min(scrollTop / qualiaDescription.offsetTop, 1);

        viewer.cameraOrbit = `${progress * 45}deg 75deg auto`;
      });
    });
  })();
</script>
