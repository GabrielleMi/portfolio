---
type HTMLTag = keyof astroHTML.JSX.IntrinsicElements;

interface Props {
  forbidden?: HTMLTag[];
  allowed?: HTMLTag[];
}

const { allowed, forbidden } = Astro.props;

const slotContent = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";
const hasTags = /<[a-z][\s\S]*>/i.test(slotContent);

if (forbidden) {
  const regexTags = new RegExp(`<(${forbidden.join("|")})\\b`, "i");

  if (regexTags.test(slotContent)) {
    throw new Error(`
        SEMANTIC ERROR : Forbidden use of ${forbidden.join(", ")} in this component.
      `);
  }
}

if (allowed && hasTags) {
  const regexTags = new RegExp(`<(${allowed.join("|")})\\b`, "i");

  if (!regexTags.test(slotContent)) {
    throw new Error(`
        SEMANTIC ERROR : Only ${allowed.join(", ")} are allowed in this component.
      `);
  }
}
---

<slot />
