---
const { variants, defaultVariant, class: className, ...props } = Astro.props;
if (!props.id) {
  console.error("Color picker needs an id");
}
if (!props.name) {
  console.error("Color picker needs a name");
}
---

<label
  style={`color:rgb(var(--${props.name}${defaultVariant ? `-${defaultVariant}` : ""}));`}
  class:list={[
    "relative before:rounded-sm cursor-pointer before:shadow before:border before:border-black before:dark:border-white before:overflow-hidden",
    "color-picker flex items-center before:mr-1",
    className,
  ]}
  data-color-picker
  data-default={defaultVariant}
  data-variants={variants ? variants.join(",") : ""}
>
  <input
    data-color-picker-input
    type="color"
    {...props}
    class="absolute inset-0 invisible"
  />
  <code data-color-picker-label class="text-black text-nowrap dark:text-white"
    >...;</code
  >
</label>
<style>
  .color-picker::before {
    background-color: currentColor;
    content: "";
    display: block;
    width: 0.7em;
    height: 0.7em;
  }
</style>
<script>
  import { getOklchFromHex } from "../../helpers/utils";
  const colorPickers = document.querySelectorAll("[data-color-picker]");

  colorPickers.forEach((colorPicker) => {
    const colorPickerInput = colorPicker.querySelector<HTMLInputElement>(
      "[data-color-picker-input]",
    );
    const colorPickerLabel = colorPicker.querySelector<HTMLLabelElement>(
      "[data-color-picker-label]",
    );

    if (!colorPickerInput || !colorPickerLabel) {
      console.error("Color picker is missing input or label element");
      return;
    }

    const variants = colorPicker.getAttribute("data-variants");
    const defaultVariant = colorPicker.getAttribute("data-default");

    if (!defaultVariant) {
      console.warn(
        "Color picker has no default variant, only the main CSS variable will be updated",
      );
    }

    const cssVarName = `--${colorPickerInput.name}`;

    const handleOnChange = (e: InputEvent) => {
      const hex = (e.currentTarget as HTMLInputElement).value;
      const oklch = getOklchFromHex(hex);

      const mainVarName = defaultVariant
        ? `${cssVarName}-${defaultVariant}`
        : cssVarName;
      document.body.style.setProperty(mainVarName, oklch);
      colorPickerLabel.innerHTML = `${oklch};`;

      if (variants && defaultVariant) {
        const splitVariants = variants.split(",");
        const defaultIndex = splitVariants.indexOf(defaultVariant);

        splitVariants.forEach((variant, i) => {
          if (variant !== defaultVariant) {
            // Calcul du delta pour ajuster la luminosité de manière cohérente
            const deltaI = defaultIndex === -1 ? i : i - defaultIndex;

            // Utilisation de color-mix(in oklch, ...)
            // On mélange vers le blanc si deltaI > 0, sinon vers le noir
            const amount = Math.abs(deltaI) * 10;
            const target = deltaI > 0 ? "white" : "black";
            const colorValue = `color-mix(in oklch, ${oklch}, ${target} ${amount}%)`;

            document.body.style.setProperty(
              `${cssVarName}-${variant}`,
              colorValue,
            );
          }
        });
      }
    };

    // Initialisation : lecture des styles actuels
    const computedStyles = getComputedStyle(document.body);
    const initialValue = computedStyles.getPropertyValue(cssVarName).trim();
    if (initialValue) {
      colorPickerLabel.innerHTML = `${initialValue};`;
    }

    colorPickerInput.addEventListener("input", handleOnChange);
  });
</script>
