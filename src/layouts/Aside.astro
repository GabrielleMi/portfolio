---
import TabControl from "../components/tabs/TabControl.astro";
import TabControls from "../components/tabs/TabControls.astro";
import TabPanel from "../components/tabs/TabPanel.astro";
import ThemeCustomizer from "../components/theme/ThemeCustomizer.astro";
import Terminal from "../components/theme/Terminal.astro";
import Tabs from "../components/tabs/Tabs.astro";
---

<aside
  class="bg-primary-900 lg:flex hidden flex-col z-10 relative rounded-tl-xl p-6 shadow-xl"
>
  <Tabs>
    <TabControls>
      <TabControl id="theme" aria-selected="true">Theme</TabControl>
      <TabControl id="console">Console</TabControl>
    </TabControls>
    <TabPanel controlId="theme">
      <ThemeCustomizer />
    </TabPanel>
    <TabPanel controlId="console" hidden>
      <Terminal />
    </TabPanel>
  </Tabs>
  <footer class="mt-auto pt-3">
    <small class="leading-none">
      © 2024, Gabrielle Michaud<br />
      <small>Made with Astro, React and Tailwind.</small>
    </small>
  </footer>
</aside>
